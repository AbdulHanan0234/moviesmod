# Database connection string (Required)
# IMPORTANT: include the database name right after .mongodb.net/ —
# without it Mongoose writes into a default db and your data will
# seem to "disappear" when the name changes.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/moviesmod?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_with_db_name_here

# Port is optional - Cloud hosts like Render assign this automatically via process.env.PORT
PORT=5000

# Allowed CORS origins (optional - defaults to "*" if not set, or provide comma-separated domains)
# Example: https://your-frontend.vercel.app
CORS_ORIGIN=*

# Admin password required for Edit and Delete operations
ADMIN_PASSWORD=your_admin_password_here
